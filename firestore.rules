rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'confirmCount', 'confirmedBy', 'status', 'escalatedAt', 'updatedAt',
          'isDuplicate', 'parentReportId', 'similarityScore'
        ]) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['confirmedBy']) ||
          !resource.data.confirmedBy.hasAny([request.auth.uid]) ||
          request.resource.data.confirmedBy.size() == resource.data.confirmedBy.size()
        )
      );
      allow delete: if isAuthenticated() && resource.data.reporterUid == request.auth.uid;
    }

    match /escalations/{escalationId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        exists(/databases/$(database)/documents/reports/$(request.resource.data.reportId)) &&
        request.resource.data.keys().hasAll(['id', 'reportId', 'draftedComplaintText', 'targetDepartment', 'sentAt', 'status', 'urgency']) &&
        request.resource.data.keys().size() == 7;
      allow update: if isAuthenticated() && 
        exists(/databases/$(database)/documents/reports/$(resource.data.reportId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['draftedComplaintText']);
    }
  }
}
